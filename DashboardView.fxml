<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<BorderPane prefHeight="460.0" prefWidth="760.0" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="application.DashboardController">

    <top>
        <Label style="-fx-font-size: 20px; -fx-font-weight: bold; -fx-padding: 15px;" text="Farm Drone Managment System" />
    </top>

    <center>
        <HBox spacing="20.0">
            <padding>
                <Insets bottom="20.0" left="20.0" right="20.0" top="10.0" />
            </padding>

            <VBox prefWidth="250.0" spacing="12.0">
                <Label style="-fx-font-size: 16px; -fx-font-weight: bold;" text="Dashboard Settings" />

                <VBox spacing="8.0">
                    <Label text="Select Option:" />
                    <ComboBox fx:id="optionCombo" maxWidth="Infinity" />
                    <HBox spacing="8.0">
                        <Button onAction="#handleSelect" text="Select" />
                        <Button onAction="#handleDelete" text="Delete" />
                    </HBox>
                </VBox>

                <Separator />

                <Label style="-fx-font-size: 16px; -fx-font-weight: bold;" text="Actions" />
                <VBox spacing="8.0">
                    <Button maxWidth="Infinity" onAction="#handleWaterZone1" text="Water - Zone 1" />
                    <Button maxWidth="Infinity" onAction="#handleWaterZone2" text="Water - Zone 2" />
                    <Button maxWidth="Infinity" onAction="#handleFieldZone1" text="Field - Zone 1" />
                    <Button maxWidth="Infinity" onAction="#handleFieldZone2" text="Field - Zone 2" />
                </VBox>
            </VBox>

            <VBox spacing="8.0" HBox.hgrow="ALWAYS">
                <Label style="-fx-font-size: 16px; -fx-font-weight: bold;" text="Messages Log:" />
                <TextArea fx:id="statusArea" editable="false" prefHeight="220.0" promptText="Status messages will appear here..." VBox.vgrow="ALWAYS" wrapText="true" />
            </VBox>
        </HBox>
    </center>

</BorderPane>