<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<BorderPane prefHeight="400.0" prefWidth="500.0" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="application.DashboardController">

    <top>
        <Label style="-fx-font-size: 20px; -fx-font-weight: bold; -fx-padding: 15px;" text="JavaFX Dashboard" />
    </top>

    <center>
        <VBox spacing="15.0">
            <padding>
                <Insets bottom="15.0" left="20.0" right="20.0" top="10.0" />
            </padding>

            <HBox alignment="CENTER_LEFT" spacing="12.0">
                <Label style="-fx-font-size: 14px;" text="Select Option:" />
                
                <ComboBox fx:id="optionCombo" prefWidth="150.0" />

                <Button onAction="#handleSelect" text="Select" />
                <Button onAction="#handleDelete" text="Delete" />
            </HBox>

            <VBox spacing="5.0" VBox.vgrow="ALWAYS">
                <Label style="-fx-font-weight: bold;" text="Messages Log:" />
                <TextArea fx:id="statusArea" editable="false" prefHeight="220.0" promptText="Status messages will appear here..." wrapText="true" />
            </VBox>
        </VBox>
    </center>

</BorderPane>